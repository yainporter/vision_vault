<%= turbo_frame_tag "image-upload" do %>
  <% flash.each do |type, message| %>
    <section class=<%= type %>>
      <p><%= message %></p>
    </section>
  <% end %>
  <% if current_user %>
    <%= simple_form_for @upload do |f| %>
    <%= f.input :name %>
    <%= f.input :description %>
    <%= f.input :image, as: :file %>
    <%= f.collection_select :vision_board_id, @vision_boards, :id, :title %>
    <%= f.button :submit %>
    <% end %>
  <% end %>
<% end %>
